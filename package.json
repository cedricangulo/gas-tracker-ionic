{
  "name": "gas-tracker-mobile",
  "version": "1.0.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "start": "ionic serve --host=127.0.0.1 --port=8100",
    "dev": "ng serve --host=127.0.0.1 --port=8100",
    "build": "ng build",
    "test": "pnpm test:unit && pnpm test:components",
    "test:php": "node scripts/test-api.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "cap:sync": "cap sync",
    "test:unit": "vitest run",
    "test:components": "ng test --watch=false",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.35",
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/forms": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@angular/router": "20.3.35",
    "@angular/service-worker": "20.3.35",
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/haptics": "^7.0.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@ionic/angular": "8.8.19",
    "@ionic/storage-angular": "^4.0.0",
    "chart.js": "^4.5.0",
    "ionicons": "^7.4.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.35",
    "@angular/cli": "20.3.35",
    "@angular/compiler-cli": "20.3.35",
    "@capacitor/cli": "7.6.10",
    "@ionic/angular-toolkit": "12.3.0",
    "@ionic/cli": "^7.2.1",
    "@prettier/plugin-php": "0.26.0",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.heat": "^0.2.4",
    "@types/node": "^24.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.11.2"
}
